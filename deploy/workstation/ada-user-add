#!/bin/bash
# Creates (or repairs) one person's own workstation account for Ada and authorizes Ada's SSH key
# for it. Installed root-owned at /usr/local/bin/ada-user-add; the operator account (ada) may run it
# with sudo and nothing else new. Both arguments are checked strictly, so the sudo rule cannot be
# used to create other users or write other files.
#
#   ada-user-add adau1a2b3c4d5e6f 'ssh-ed25519 AAAA... ada@agentsam'
set -euo pipefail
umask 077

name="${1:-}"
key="${2:-}"

if [[ ! "$name" =~ ^adau[0-9a-f]{12}$ ]]; then
  echo "ada-user-add: the account name must be adau followed by 12 lowercase hex digits" >&2
  exit 2
fi
if [[ ! "$key" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+={0,3}(\ [A-Za-z0-9@._-]{1,64})?$ ]] || [ "${#key}" -gt 400 ]; then
  echo "ada-user-add: the key must be one ssh-ed25519 public key" >&2
  exit 2
fi

if ! id -u "$name" >/dev/null 2>&1; then
  # Its own group, a normal shell, no password (key login only), and no extra groups: no sudo.
  useradd --create-home --user-group --shell /bin/bash --comment "Ada workstation account" "$name"
  passwd --lock "$name" >/dev/null
fi

home="$(getent passwd "$name" | cut -d: -f6)"
case "$home" in /home/adau*) ;; *) echo "ada-user-add: unexpected home folder $home" >&2; exit 3 ;; esac
chmod 700 "$home"
install -d -m 700 -o "$name" -g "$name" "$home/.ssh"
# One key, no agent or X11 forwarding; plain commands and jobs only.
printf 'no-agent-forwarding,no-X11-forwarding %s\n' "$key" > "$home/.ssh/authorized_keys"
chown "$name:$name" "$home/.ssh/authorized_keys"
chmod 600 "$home/.ssh/authorized_keys"

# Resource limits for everything the account runs (SSH sessions land in user-<uid>.slice).
uid="$(id -u "$name")"
install -d -m 755 "/etc/systemd/system/user-$uid.slice.d"
cat > "/etc/systemd/system/user-$uid.slice.d/50-ada-limits.conf" <<LIMITS
[Slice]
MemoryMax=2G
TasksMax=256
CPUQuota=100%
LIMITS
systemctl daemon-reload

echo "ada-user-add: $name is ready"
